{
  "name": "Social Media Autopilot",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "social_media_autopilot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "autopilot_run": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "socialStudio",
            "args": {
              "action": "autoRun"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Publish due posts & top up queue",
            "description": "Publishes scheduled posts to Facebook and auto-generates new content"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9,13,17 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomous Facebook posting engine \u2014 runs 3\u00d7 daily (9am, 1pm, 5pm ET). Publishes all due scheduled posts, then tops up the queue with AI-generated scroll-stopping content (captions, hashtags, SEO/AEO keywords, images)."
}