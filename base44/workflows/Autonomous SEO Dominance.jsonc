{
  "name": "Autonomous SEO Dominance",
  "description": "Every 6 hours, runs the full autonomous SEO/AEO dominance cycle: pulls fresh Google Search Console data, discovers page-2+ opportunity keywords, auto-generates new content pages, re-optimizes underperforming pages, fills content gaps from competitor analysis, and submits all changes to IndexNow for instant crawling. Designed to push the site to page 1 of Google as aggressively and persistently as possible.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_seo_dominance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_dominance_cycle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousSeoDominance",
            "args": {
              "max_new_pages": 5
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run autonomous SEO dominance cycle",
            "description": "Pull GSC data, discover keywords, generate pages, re-optimize, submit to indexers"
          }
        }
      }
    ]
  }
}