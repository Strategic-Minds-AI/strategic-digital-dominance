{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Autonomous Sprint Supervisor",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_sprint_supervisor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sprint": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousSprint"
          },
          "then": "end",
          "x-base44": {
            "title": "Execute autonomous sprint invariant",
            "description": "Generate work for systems below 100"
          }
        }
      }
    ]
  },
  "description": "Permanent 5-minute heartbeat that executes the autonomous completion sprint invariant: IF SYSTEM < 100 AND NO WORK QUEUED THEN GENERATE WORK. All state persists in canonical Supabase (Xtreme OS)."
}