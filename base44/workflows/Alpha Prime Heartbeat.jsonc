{
  "name": "Alpha Prime Heartbeat",
  "description": "Autonomous 5-minute health monitor \u2014 checks source drift, sitemap canonical drift, connector freshness, critical findings, stale tasks, and smoke checks. Computes a deterministic health score and updates the CanonicalSiteRegistry. This is the deepest health-monitoring layer in the two-clock heartbeat architecture.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alpha_prime_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_heartbeat": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alphaPrimeHeartbeat",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run Alpha Prime heartbeat",
            "description": "Source drift, sitemap canonical drift, connector freshness, smoke checks, health score"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}