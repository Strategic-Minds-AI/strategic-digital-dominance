{
  "name": "Alpha Prime Heartbeat",
  "description": "Single 5-minute control clock. Runs the proven Alpha Prime health heartbeat, then a bounded NearMe/NearYou reconciliation in dry-run mode. No second cron is created and no protected external action is executed.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alpha_prime_heartbeat",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "run_heartbeat": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alphaPrimeHeartbeat",
            "args": {}
          },
          "then": "run_nearme_reconcile",
          "x-base44": {
            "title": "Run Alpha Prime heartbeat",
            "description": "Source drift, sitemap canonical drift, connector freshness, smoke checks, health score"
          }
        }
      },
      {
        "run_nearme_reconcile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nearmeReconcile",
            "args": {
              "mode": "dry_run"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run NearMe/NearYou reconciliation",
            "description": "Read-only registry, opportunity, validation, attribution, and approval reconciliation"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
