{
  "name": "Swarm Autopilot",
  "description": "Autonomous AGI swarm heartbeat \u2014 every 30 minutes, runs the full auto-cycle: audit \u2192 fix \u2192 heal \u2192 harden \u2192 optimize AEO/SEO \u2192 health check \u2192 dispatch. This is the brain that keeps the platform self-optimizing and growing.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "swarm_autopilot",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_cycle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "swarmOrchestrator",
            "args": {
              "action": "autoCycle"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Full autonomous AGI cycle",
            "description": "Audit \u2192 Fix \u2192 Heal \u2192 Harden \u2192 Optimize AEO \u2192 Dispatch"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}