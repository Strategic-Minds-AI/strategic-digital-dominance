{
  "name": "AgentAction",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this action (multi-tenant isolation)"
    },
    "action_id": {
      "type": "string",
      "description": "Stable deterministic action ID"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent persona ID assigned to this action"
    },
    "agent_short_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "action_category": {
      "type": "string",
      "enum": [
        "lead_management",
        "seo_optimization",
        "content_creation",
        "email_campaign",
        "social_media",
        "phone_call",
        "sms_message",
        "data_analysis",
        "research",
        "deployment",
        "code_change",
        "file_operation",
        "browser_automation",
        "calendar_management",
        "task_management",
        "reporting",
        "audit",
        "repair",
        "benchmark",
        "communication",
        "monitoring",
        "scheduling",
        "custom"
      ],
      "default": "custom"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "function_invoke",
        "entity_crud",
        "api_call",
        "browser_action",
        "communication",
        "composite",
        "manual"
      ],
      "default": "function_invoke"
    },
    "target_function": {
      "type": "string"
    },
    "target_entity": {
      "type": "string"
    },
    "entity_operation": {
      "type": "string",
      "enum": [
        "create",
        "read",
        "update",
        "delete",
        "list",
        "filter"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "manual",
        "schedule",
        "event",
        "condition",
        "webhook",
        "entity_change",
        "interval",
        "one_time"
      ],
      "default": "manual"
    },
    "schedule_config": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "once",
            "recurring",
            "continuous"
          ],
          "default": "once"
        },
        "interval_seconds": {
          "type": "integer",
          "default": 0
        },
        "cron_expression": {
          "type": "string"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_24_7": {
          "type": "boolean",
          "default": false
        },
        "days_of_week": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hours_of_day": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      }
    },
    "trigger_condition": {
      "type": "string"
    },
    "trigger_entity": {
      "type": "string"
    },
    "trigger_event_type": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "default": "normal"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "advisory",
        "supervised",
        "autonomous",
        "full_autonomous"
      ],
      "default": "supervised"
    },
    "requires_approval": {
      "type": "boolean",
      "default": false
    },
    "max_retries": {
      "type": "integer",
      "default": 3
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 300
    },
    "rollback_action_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "running",
        "completed",
        "failed",
        "blocked",
        "archived"
      ],
      "default": "draft"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_result": {
      "type": "string",
      "maxLength": 3000
    },
    "last_error": {
      "type": "string"
    },
    "execution_count": {
      "type": "integer",
      "default": 0
    },
    "success_count": {
      "type": "integer",
      "default": 0
    },
    "failure_count": {
      "type": "integer",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action_id",
    "agent_id",
    "title",
    "action_category",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}