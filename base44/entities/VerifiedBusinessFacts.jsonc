{
  "name": "VerifiedBusinessFacts",
  "type": "object",
  "properties": {
    "fact_id": {
      "type": "string",
      "description": "Deterministic identifier (e.g. primary_business_name, primary_phone, hq_address)"
    },
    "fact_type": {
      "type": "string",
      "enum": [
        "business_name",
        "legal_entity",
        "primary_phone",
        "email",
        "address",
        "rating",
        "review_count",
        "warranty_claims",
        "service_claims",
        "financing_claims",
        "location_count",
        "parent_organizations",
        "social_profiles",
        "licenses_certifications",
        "service_area",
        "business_hours"
      ],
      "description": "Category of this verified fact"
    },
    "fact_value": {
      "type": "string",
      "description": "The operator-approved value for this fact"
    },
    "fact_value_numeric": {
      "type": "number",
      "description": "Numeric value for facts like rating, review_count, location_count"
    },
    "fact_value_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List value for facts like social_profiles, parent_organizations"
    },
    "evidence_url": {
      "type": "string",
      "description": "URL where this fact was verified (e.g. Google Business Profile, official website)"
    },
    "evidence_description": {
      "type": "string",
      "description": "How this fact was verified and why it is trustworthy"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string",
      "description": "Who verified this fact (operator name, agent name, or system)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0,
      "description": "0-1 confidence in this fact (1 = operator-confirmed, 0.5 = inferred, 0 = unverified)"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "pending_verification",
        "conflict_detected",
        "unverified",
        "superseded"
      ],
      "default": "unverified"
    },
    "conflict_notes": {
      "type": "string",
      "description": "If status=conflict_detected, what sources disagree and how"
    },
    "superseded_by": {
      "type": "string",
      "description": "If status=superseded, the fact_id that replaces this one"
    },
    "applicable_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Location IDs where this fact applies (empty = all locations / national)"
    }
  },
  "required": [
    "fact_id",
    "fact_type",
    "fact_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}