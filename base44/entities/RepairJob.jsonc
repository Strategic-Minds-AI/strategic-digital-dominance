{
  "name": "RepairJob",
  "type": "object",
  "properties": {
    "repair_id": {
      "type": "string",
      "description": "Stable deterministic ID"
    },
    "system_id": {
      "type": "string",
      "description": "Owning system",
      "default": "epoxyquotenearme"
    },
    "benchmark_id": {
      "type": "string"
    },
    "gap_id": {
      "type": "string"
    },
    "failure_fingerprint": {
      "type": "string",
      "description": "Deterministic hash of failure signature for idempotency"
    },
    "root_cause": {
      "type": "string",
      "maxLength": 2000
    },
    "affected_system": {
      "type": "string"
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "affected_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "reproduction_steps": {
      "type": "string",
      "maxLength": 3000
    },
    "expected_state": {
      "type": "string",
      "maxLength": 2000
    },
    "observed_state": {
      "type": "string",
      "maxLength": 2000
    },
    "implementation_plan": {
      "type": "string",
      "maxLength": 5000,
      "description": "Exact work, not vague"
    },
    "assigned_specialist": {
      "type": "string",
      "description": "software_engineer, seo_specialist, etc."
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "rollback": {
      "type": "string",
      "maxLength": 2000,
      "description": "How to undo if repair fails"
    },
    "acceptance_test": {
      "type": "string",
      "maxLength": 2000
    },
    "regression_test": {
      "type": "string",
      "maxLength": 2000
    },
    "postcondition_validator": {
      "type": "string",
      "description": "Function that validates the fix"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "in_progress",
        "implemented",
        "validating",
        "regression_testing",
        "production_verified",
        "closed",
        "blocked",
        "failed"
      ],
      "default": "queued"
    },
    "implementer": {
      "type": "string",
      "description": "Agent that implements"
    },
    "validator": {
      "type": "string",
      "description": "Independent agent that validates"
    },
    "release_authority": {
      "type": "string",
      "description": "Agent that authorizes release"
    },
    "approval_required": {
      "type": "boolean",
      "default": false,
      "description": "Protected action needing operator approval"
    },
    "approval_packet_id": {
      "type": "string"
    },
    "claimed_by": {
      "type": "string",
      "description": "Worker/agent that claimed this job via lease"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current claim lease expires"
    },
    "attempt_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of claim attempts"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last worker heartbeat while claimed"
    },
    "occurrence_count": {
      "type": "integer",
      "default": 1,
      "description": "How many times this same failure has been observed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "repair_id",
    "system_id",
    "benchmark_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}