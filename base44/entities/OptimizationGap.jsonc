{
  "name": "OptimizationGap",
  "type": "object",
  "properties": {
    "gap_id": {
      "type": "string",
      "description": "Stable ID (system_id + benchmark_id)"
    },
    "system_id": {
      "type": "string",
      "description": "Owning system",
      "default": "epoxyquotenearme"
    },
    "benchmark_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "delta": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "business_impact": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "estimated_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "estimated_cost": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "change_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "repair_priority_score": {
      "type": "number",
      "description": "Deterministic priority score"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_repair",
        "validated",
        "closed",
        "blocked"
      ],
      "default": "open"
    },
    "repair_job_id": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last cycle this gap was observed"
    },
    "occurrence_count": {
      "type": "integer",
      "default": 1,
      "description": "How many cycles this gap has been observed"
    },
    "latest_cycle": {
      "type": "string",
      "description": "Most recent cycle_id that observed this gap"
    },
    "latest_evidence": {
      "type": "string",
      "maxLength": 3000,
      "description": "Most recent actual value observed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "gap_id",
    "system_id",
    "benchmark_id",
    "cycle_id",
    "severity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}