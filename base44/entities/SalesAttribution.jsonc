{
  "name": "SalesAttribution",
  "type": "object",
  "properties": {
    "attribution_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "medium": {
      "type": "string"
    },
    "campaign": {
      "type": "string"
    },
    "revenue": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "revenue_source": {
      "type": "string",
      "enum": [
        "crm",
        "order",
        "manual_verified"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string"
    }
  },
  "required": [
    "attribution_id",
    "revenue_source",
    "revenue",
    "currency",
    "evidence_ref"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
