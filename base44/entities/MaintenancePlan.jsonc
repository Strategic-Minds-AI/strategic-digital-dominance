{
  "name": "MaintenancePlan",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "project_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "floor_system": {
      "type": "string"
    },
    "cleaning_instructions": {
      "type": "string",
      "maxLength": 2000
    },
    "seasonal_reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "season": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "month": {
            "type": "string"
          }
        }
      }
    },
    "recommended_products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          }
        }
      }
    },
    "warranty_terms": {
      "type": "string",
      "maxLength": 2000
    },
    "pdf_url": {
      "type": "string",
      "description": "Generated care guide PDF URL"
    }
  },
  "required": [
    "project_id",
    "client_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}