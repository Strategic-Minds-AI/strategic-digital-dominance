{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "estimate | followup:reminder | followup:gallery | followup:offer | followup:final"
    },
    "message_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "sent"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "to_email",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}