{
  "name": "SwarmTask",
  "type": "object",
  "properties": {
    "task_type": {
      "type": "string",
      "description": "Category of work"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "in_progress",
        "completed",
        "failed",
        "superseded",
        "discovered",
        "planned",
        "specified",
        "approved",
        "assigned",
        "artifact_created",
        "tested",
        "staged",
        "deployed",
        "validating",
        "production_verified",
        "closed",
        "blocked",
        "rolled_back"
      ],
      "default": "pending"
    },
    "assigned_agent": {
      "type": "string"
    },
    "created_by_agent": {
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "lead_id": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "entity_type": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "result": {
      "type": "string",
      "maxLength": 5000
    },
    "result_summary": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "retry_count": {
      "type": "integer",
      "default": 0
    },
    "max_retries": {
      "type": "integer",
      "default": 3
    },
    "conversation_id": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "spawned_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "task_type",
    "title",
    "assigned_agent"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}