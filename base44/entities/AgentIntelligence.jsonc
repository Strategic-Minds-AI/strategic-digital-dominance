{
  "name": "AgentIntelligence",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this intelligence (multi-tenant isolation)"
    },
    "title": {
      "type": "string"
    },
    "intelligence_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "market_research",
        "competitor_analysis",
        "industry_trends",
        "customer_insights",
        "product_knowledge",
        "sales_playbook",
        "technical_docs",
        "company_policy",
        "brand_guidelines",
        "seo_strategy",
        "domain_strategy",
        "operational_data",
        "training_material",
        "custom"
      ],
      "default": "custom"
    },
    "content": {
      "type": "string",
      "maxLength": 50000
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "assigned_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "assigned_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_shared": {
      "type": "boolean",
      "default": true
    },
    "access_level": {
      "type": "string",
      "enum": [
        "all_agents",
        "category_only",
        "assigned_only",
        "owner_only"
      ],
      "default": "all_agents"
    },
    "embedding_vector": {
      "type": "string",
      "maxLength": 5000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.9
    },
    "freshness_requirement": {
      "type": "string"
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_refresh": {
      "type": "boolean",
      "default": false
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "category",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}