{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "lead_source": {
      "type": "string",
      "default": "website"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "homeowner",
        "contractor",
        "business",
        "b2b",
        "social"
      ],
      "description": "Category of lead for routing and outreach"
    },
    "referrer": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_term": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "garage_size": {
      "type": "string"
    },
    "custom_length": {
      "type": "number"
    },
    "custom_width": {
      "type": "number"
    },
    "square_footage": {
      "type": "number"
    },
    "sqft_source": {
      "type": "string",
      "description": "Which source provided the garage sqft"
    },
    "sqft_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "floor_condition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_system": {
      "type": "string"
    },
    "flake_color": {
      "type": "string"
    },
    "flake_color_name": {
      "type": "string"
    },
    "flake_color_hex": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concept_image": {
      "type": "string"
    },
    "estimate_mid": {
      "type": "number"
    },
    "estimate_low": {
      "type": "number"
    },
    "estimate_high": {
      "type": "number"
    },
    "package_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "lead_score": {
      "type": "number",
      "default": 0
    },
    "assigned_salesperson": {
      "type": "string"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "appointment_status": {
      "type": "string",
      "default": "none"
    },
    "enrichment": {
      "type": "string",
      "maxLength": 3000
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW ESTIMATE",
        "CONTACT ATTEMPTED",
        "CONSULTATION BOOKED",
        "CONSULTATION COMPLETED",
        "IN-HOME ESTIMATE BOOKED",
        "IN-HOME ESTIMATE COMPLETED",
        "PROPOSAL SENT",
        "WON",
        "LOST",
        "NURTURE"
      ],
      "default": "NEW ESTIMATE"
    },
    "won_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "email",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}