{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Opportunity title"
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "problem": {
      "type": "string",
      "maxLength": 5000,
      "description": "The problem people are complaining about"
    },
    "buyer": {
      "type": "string",
      "description": "Who would pay for the solution"
    },
    "app_idea": {
      "type": "string",
      "maxLength": 5000,
      "description": "What app/tool/SaaS to build"
    },
    "monetization": {
      "type": "string",
      "maxLength": 2000,
      "description": "How to make money from this"
    },
    "evidence": {
      "type": "string",
      "maxLength": 3000
    },
    "source_url": {
      "type": "string"
    },
    "scanner_source": {
      "type": "string",
      "description": "Which scanner found this (scan_google_trends, etc)"
    },
    "scanner_label": {
      "type": "string",
      "description": "Human-readable scanner name"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Opportunity score 0-10"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "reviewing",
        "validated",
        "building",
        "launched",
        "archived"
      ],
      "default": "saved"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "scanner_source"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}