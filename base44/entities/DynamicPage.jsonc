{
  "name": "DynamicPage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL slug \u2014 page renders at /p/{slug}"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "hero",
              "text",
              "gallery",
              "cta",
              "faq",
              "testimonials",
              "html",
              "form",
              "spacer"
            ]
          },
          "props": {
            "type": "object",
            "description": "Section-specific properties (heading, body, images, items, etc.)"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string",
      "maxLength": 300
    },
    "is_public": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}