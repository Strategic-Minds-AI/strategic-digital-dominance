{
  "name": "AgentMemory",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this memory (multi-tenant isolation)"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent persona ID or 'shared' for cross-agent shared memory"
    },
    "agent_short_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "sales",
        "technical",
        "client_history",
        "market_intel",
        "competitor_intel",
        "seo",
        "lead_data",
        "process",
        "policy",
        "conversation",
        "decision",
        "lesson_learned",
        "custom"
      ],
      "default": "general"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "instruction",
        "observation",
        "decision",
        "outcome",
        "context",
        "skill"
      ],
      "default": "fact"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "maxLength": 10000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.8
    },
    "importance": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "is_shared": {
      "type": "boolean",
      "default": false
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "access_count": {
      "type": "integer",
      "default": 0
    },
    "embedding_vector": {
      "type": "string",
      "maxLength": 5000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_id",
    "category",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}