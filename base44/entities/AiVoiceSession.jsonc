{
  "name": "AiVoiceSession",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Provider conversation / call control ID"
    },
    "persona_id": {
      "type": "string",
      "description": "Reference to AgentPersona used for the call"
    },
    "persona_name": {
      "type": "string"
    },
    "to_number": {
      "type": "string"
    },
    "from_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "streaming",
        "listening",
        "speaking",
        "interrupted",
        "summarized",
        "ended",
        "failed"
      ],
      "default": "streaming"
    },
    "stt_text": {
      "type": "string",
      "description": "Speech-to-text transcript of the caller"
    },
    "tts_text": {
      "type": "string",
      "description": "Text the AI spoke"
    },
    "tts_audio_url": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_sec": {
      "type": "number",
      "default": 0
    },
    "total_turns": {
      "type": "integer",
      "default": 0
    },
    "sentiment_summary": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "integer",
          "default": 0
        },
        "neutral": {
          "type": "integer",
          "default": 0
        },
        "negative": {
          "type": "integer",
          "default": 0
        },
        "dominant": {
          "type": "string"
        }
      }
    },
    "provider_response": {
      "type": "string",
      "description": "Raw provider response JSON for debugging"
    }
  },
  "required": [
    "to_number"
  ]
}