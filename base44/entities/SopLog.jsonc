{
  "name": "SopLog",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "build",
        "seo",
        "lead",
        "email",
        "integration",
        "content",
        "ops"
      ],
      "default": "ops"
    },
    "action": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "detail": {
      "type": "string",
      "maxLength": 1000
    },
    "meta": {
      "type": "string",
      "description": "JSON string of extra context"
    },
    "source": {
      "type": "string",
      "description": "Function or agent that logged the step"
    }
  },
  "required": [
    "category",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}