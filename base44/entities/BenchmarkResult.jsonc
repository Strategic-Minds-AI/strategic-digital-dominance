{
  "name": "BenchmarkResult",
  "type": "object",
  "properties": {
    "benchmark_id": {
      "type": "string",
      "description": "Which benchmark was run"
    },
    "system_id": {
      "type": "string",
      "description": "Owning system",
      "default": "epoxyquotenearme"
    },
    "cycle_id": {
      "type": "string",
      "description": "Optimization cycle this result belongs to"
    },
    "target": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "delta": {
      "type": "string",
      "description": "Difference between target and actual"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown",
        "stale"
      ],
      "default": "unknown"
    },
    "severity": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "mandatory": {
      "type": "boolean",
      "default": true
    },
    "evidence_receipt_id": {
      "type": "string"
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    },
    "validator": {
      "type": "string",
      "description": "Function or agent that measured"
    },
    "details": {
      "type": "string",
      "maxLength": 3000
    },
    "failure_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "benchmark_id",
    "system_id",
    "cycle_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}