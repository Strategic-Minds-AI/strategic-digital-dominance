{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategicmindsai.com/schemas/digital-dominance-site-pack-v1.json",
  "title": "Digital Dominance V3 Site Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "tenant_id",
    "site",
    "pages",
    "workflow"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,100}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_name",
        "vertical",
        "country",
        "primary_market",
        "offer",
        "canonical_origin"
      ],
      "properties": {
        "brand_name": {
          "type": "string",
          "minLength": 2
        },
        "vertical": {
          "type": "string",
          "minLength": 2
        },
        "country": {
          "type": "string",
          "minLength": 2
        },
        "primary_market": {
          "type": "string",
          "minLength": 2
        },
        "offer": {
          "type": "string",
          "minLength": 8
        },
        "canonical_origin": {
          "type": "string",
          "format": "uri"
        },
        "verified_real_business": {
          "type": "boolean",
          "default": false
        },
        "fulfillment_evidence_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "title",
          "description",
          "sections",
          "index_request",
          "facts"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(?:[a-z0-9-]+/)*$"
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 90
          },
          "description": {
            "type": "string",
            "maxLength": 170
          },
          "sections": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "heading",
                "body"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "hero",
                    "services",
                    "pricing",
                    "faq",
                    "proof",
                    "calculator",
                    "availability",
                    "comparison",
                    "cta",
                    "contact",
                    "custom"
                  ]
                },
                "heading": {
                  "type": "string"
                },
                "body": {
                  "type": "string",
                  "minLength": 10
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim",
                "source_url",
                "verified_at"
              ],
              "properties": {
                "claim": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "index_request": {
            "type": "boolean",
            "default": false
          },
          "canonical_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "lead_capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "consent_text": {
          "type": "string"
        },
        "crm_route_id": {
          "type": "string"
        },
        "test_mode": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_only": {
          "const": true
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "facebook",
              "instagram",
              "youtube",
              "tiktok",
              "pinterest",
              "linkedin",
              "google_business_profile"
            ]
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "approval_required",
        "idempotency_key"
      ],
      "properties": {
        "mode": {
          "const": "preview"
        },
        "approval_required": {
          "const": true
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 12
        },
        "source_commit": {
          "type": "string"
        },
        "validator_profile": {
          "enum": [
            "full",
            "synthetic"
          ],
          "default": "full"
        }
      }
    }
  }
}
